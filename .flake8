
[flake8]
max-line-length = 120
# Rules that conflict with the formatting of black (e.g. spaces in `x[a : b]`)
extend-ignore = E203, E701
# Type stubs of streampu._ext, generated by scripts/generate_stubs.sh
extend-exclude = streampu/_ext
accept-encodings = UTF-8
per-file-ignores =
    streampu/__init__.py: F401, A004, I001, I004, I005, E402
    streampu/_bop.py: A001
    streampu/_minmax.py: A001
    streampu/_probe.py: I001, I005
    streampu/_red.py: A001
    streampu/_socket.py: F811
    streampu/_uop.py: A001
    examples/custom_cpp_module/tests/test_custom_cpp_module.py: E402